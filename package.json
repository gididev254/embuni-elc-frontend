{
  "name": "elp-frontend",
  "version": "1.0.0",
  "description": "Frontend for University of Embu Equity Leaders Program",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:production": "npm run lint && npm run typecheck && vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "cypress open",
    "test:e2e:headless": "cypress run",
    "test:ci": "vitest run --coverage && start-server-and-test preview http://localhost:4173 \"cypress run\"",
    "test:watch": "vitest watch",
    "typecheck": "tsc --noEmit",
    "analyze": "npm run build && npx vite-bundle-analyzer dist",
    "security:audit": "npm audit --audit-level=moderate",
    "security:fix": "npm audit fix"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.15.0",
    "@jitsi/react-sdk": "^1.4.4",
    "@mui/material": "^5.14.20",
    "@mui/icons-material": "^5.14.20",
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "react-toastify": "^9.1.3",
    "next": "^14.0.3",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.0.0",
    "axios": "^1.3.5",
    "clsx": "^2.0.0",
    "date-fns": "^2.30.0",
    "date-fns-tz": "^1.4.7",
    "i18next": "^22.4.10",
    "i18next-browser-languagedetector": "^7.0.1",
    "lucide-react": "^0.263.1",
    "react-i18next": "^12.2.0",
    "react-slick": "^0.29.0",
    "recharts": "^2.7.0",
    "slick-carousel": "^1.8.1",
    "socket.io-client": "^4.6.1",
    "vite": "^4.3.2",
    "vite-plugin-svgr": "^2.4.0",
    "zustand": "^4.3.8"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.9",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/react-router-dom": "^5.3.3",
    "@types/react-slick": "^0.23.10",
    "@typescript-eslint/eslint-plugin": "^5.59.0",
    "@typescript-eslint/parser": "^5.59.0",
    "autoprefixer": "^10.4.14",
    "cypress": "^12.12.0",
    "eslint": "^8.38.0",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jsdom": "^21.1.0",
    "postcss": "^8.4.21",
    "prettier": "^2.8.7",
    "start-server-and-test": "^1.15.2",
    "tailwindcss": "^3.3.1",
    "typescript": "^4.9.5",
    "vite-bundle-analyzer": "^1.0.0",
    "vitest": "^0.30.1"
  }
}
